# Copy to .env — `docker compose` picks it up automatically, and .gitignore
# keeps it out of the repository.

# Signs session tokens and encrypts the credentials stored against every source.
# At least 16 characters in production. It has to stay stable once you have
# sources configured: changing it invalidates all sessions and makes the stored
# source secrets unreadable.
#   generate with: openssl rand -base64 36
JWT_SECRET=

# The single admin account. There is no user management by design, so this pair
# is the only way in — the built-in fallback password is not a real one.
ADMIN_USER=admin
ADMIN_PASSWORD=
