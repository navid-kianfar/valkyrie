{
  "name": "valkyrie",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @valkyrie/api --filter @valkyrie/web --parallel dev",
    "dev:redis": "pnpm --filter @valkyrie/api dev:redis",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @valkyrie/api db:generate",
    "db:migrate": "pnpm --filter @valkyrie/api db:migrate"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "ssh2",
      "cpu-features",
      "esbuild",
      "redis-memory-server",
      "@swc/core",
      "sqlite3"
    ]
  }
}
